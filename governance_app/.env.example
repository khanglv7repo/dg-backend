APP_ENV=local
APP_LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://governance:change-me@localhost:5432/governance

# OpenMetadata execution identities (machine identities, never human tokens).
OPENMETADATA_ENABLED=false
OPENMETADATA_BASE_URL=http://localhost:8585/api
OPENMETADATA_EXECUTION_BOT_NAME=governance-execution-bot
OM_AUTOCLASSIFICATION_BOT_TOKEN=
OM_AUTO_TAG_BOT_TOKEN=
OM_INGESTION_BOT_TOKEN=
OPENMETADATA_TIMEOUT_SECONDS=15
TRUSTED_AUTO_APPLY_ENABLED=false

OPENMETADATA_INGESTION_IMAGE=openmetadata/ingestion:1.13.1
OM_DOCKER_NETWORK=data-governance-lab_governance_net
INGESTION_SERVICE_NAME=financial_postgres
INGESTION_INTERVAL_SECONDS=3600

AGENT_ENABLED=false
AGENT_NAME=classification-agent
AGENT_GRAPH_VERSION=classification-graph-v1
AGENT_PROMPT_VERSION=classification-prompt-v1
OPENMETADATA_AGENT_BOT_NAME=governance-agent-bot
OPENMETADATA_MCP_URL=http://localhost:8585/mcp
OPENMETADATA_AGENT_BOT_TOKEN=
OPENMETADATA_MCP_TIMEOUT_SECONDS=30
AGENT_INCLUDE_LINEAGE=true

LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=

# Ranger.
RANGER_ENABLED=false
RANGER_BASE_URL=http://localhost:6080/service/public/v2/api
RANGER_TAG_STORE_BASE_URL=http://localhost:6080/service/tags
RANGER_SERVICE_ACCOUNT=governance-ranger-service
RANGER_SERVICE_SECRET=

# Flow B resource service. Existing RANGER_SERVICE_NAME remains supported.
RANGER_SERVICE_NAME=dev_trino

# Flow A static tag-policy service.
RANGER_TAG_SERVICE_NAME=dev_tag
RANGER_RECONCILE_TAG_POLICIES_ON_STARTUP=true

# Set false in the local lab when you want restart to actually mutate Ranger.
RANGER_DRY_RUN=true
RANGER_TIMEOUT_SECONDS=15
RANGER_ALLOW_POLICY_DELETE=false

TRINO_ENABLED=false
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=hive
TRINO_SCHEMA=default
TRINO_VERIFICATION_SERVICE_USER=governance-verifier-bot
TRINO_HTTP_SCHEME=http
TRINO_TIMEOUT_SECONDS=20

CLASSIFICATION_RULES_PATH=config/classification_rules.yaml
POLICY_MAPPINGS_PATH=config/policies.yaml
EXECUTION_WORKER_ID=execution-worker-1
AGENT_WORKER_ID=agent-worker-1
WORKER_POLL_SECONDS=1
WORKER_CLAIM_BATCH=8
WORKER_STALE_AFTER_SECONDS=300
TRUSTED_IDENTITY_HEADERS=true
